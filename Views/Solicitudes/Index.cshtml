@model IReadOnlyList<SolicitudSesion>
@{
    ViewData["Title"] = "Solicitudes registradas";
}

<div class="container py-5 pagina-interna">
  <h2 class="section-title d-block text-center mb-4">Solicitudes registradas</h2>

  @if (TempData["Mensaje"] is string mensaje)
  {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      @mensaje
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
  }

  @if (Model.Count == 0)
  {
    <p class="text-center text-muted">Aún no hay ninguna solicitud registrada.</p>
    <div class="text-center">
      <a asp-action="Crear" class="btn btn-warning">Crear una solicitud</a>
    </div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Sesión</th>
            <th>Fecha</th>
            <th>Extras</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var s in Model)
          {
            var extras = Catalogo.NombresExtras(s.Adicionales).ToList();
            <tr>
              <td>@s.Id</td>
              <td>@s.Nombre</td>
              <td>@s.TipoSesion</td>
              <td>@(s.Fecha?.ToString("dd/MM/yyyy") ?? "Por definir")</td>
              <td>@(extras.Count > 0 ? string.Join(", ", extras) : "Ninguno")</td>
              <td>
                <form asp-action="Eliminar" asp-route-id="@s.Id" method="post"
                      onsubmit="return confirm('¿Eliminar esta solicitud?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
