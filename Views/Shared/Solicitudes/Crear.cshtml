@model SolicitudSesion
@{
    ViewData["Title"] = "Contacto";
}

<section id="contacto" class="py-5 pagina-interna">
  <div class="container">
    <h2 class="section-title text-center">Contáctanos</h2>
    <p class="text-center mb-4">Escríbenos y agenda tu sesión. Responderemos a la brevedad.</p>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <form asp-action="Crear" method="post" novalidate>
          <div asp-validation-summary="ModelOnly" class="text-danger"></div>

          <fieldset class="mb-4">
            <legend class="fs-5"><strong>Datos personales</strong></legend>
            <div class="row g-3">
              <div class="col-md-6">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: María Gómez">
                <span asp-validation-for="Nombre" class="text-danger"></span>
              </div>
              <div class="col-md-6">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" type="email" class="form-control" placeholder="tucorreo@ejemplo.com">
                <span asp-validation-for="Correo" class="text-danger"></span>
              </div>
              <div class="col-md-6">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" type="tel" class="form-control" placeholder="Ej: 3001234567">
                <span asp-validation-for="Telefono" class="text-danger"></span>
              </div>
              <div class="col-md-6">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" type="date" class="form-control">
                <span asp-validation-for="Fecha" class="text-danger"></span>
              </div>
            </div>
          </fieldset>

          <fieldset class="mb-4">
            <legend class="fs-5"><strong>Detalles del servicio</strong></legend>

            <div class="mb-3">
              <label class="form-label d-block">Tipo de sesión</label>
              <div class="d-flex flex-wrap gap-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" asp-for="TipoSesion" id="tipo-boda" value="Boda">
                  <label class="form-check-label" for="tipo-boda">Boda</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" asp-for="TipoSesion" id="tipo-retrato" value="Retrato">
                  <label class="form-check-label" for="tipo-retrato">Retrato</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" asp-for="TipoSesion" id="tipo-evento" value="Evento">
                  <label class="form-check-label" for="tipo-evento">Evento corporativo</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" asp-for="TipoSesion" id="tipo-producto" value="Producto">
                  <label class="form-check-label" for="tipo-producto">Producto</label>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label d-block">Servicios adicionales</label>
              <div class="d-flex flex-wrap gap-3">
                @foreach (var extra in Catalogo.Extras)
                {
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Adicionales"
                           id="add-@extra.Id" value="@extra.Id"
                           checked="@Model.Adicionales.Contains(extra.Id)">
                    <label class="form-check-label" for="add-@extra.Id">@extra.Nombre</label>
                  </div>
                }
              </div>
            </div>

            <div class="mb-3">
              <label asp-for="Invitados" class="form-label"></label>
              <input asp-for="Invitados" class="form-control" min="1" max="500" placeholder="Ej: 50">
              <span asp-validation-for="Invitados" class="text-danger"></span>
            </div>

            <div class="mb-3">
              <label asp-for="Mensaje" class="form-label"></label>
              <textarea asp-for="Mensaje" class="form-control" rows="4" placeholder="Describe la idea que tienes en mente..."></textarea>
              <span asp-validation-for="Mensaje" class="text-danger"></span>
            </div>
          </fieldset>

          <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-warning btn-lg px-5">Enviar solicitud</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
