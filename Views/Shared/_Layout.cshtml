<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lente Vivo | Agencia de Fotografía</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LenteVivo.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="main-nav">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Lente<span class="brand-accent">Vivo</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto text-center">
                    <li class="nav-item"><a class="nav-link" href="/#inicio">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#servicios">Servicios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#galeria">Galería</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#paquetes">Paquetes</a></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Solicitudes" asp-action="Crear">Contacto</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="py-4 text-center">
        <p class="mb-1">&copy; 2026 Lente Vivo - Agencia de Fotografía. Todos los derechos reservados.</p>
        <address class="mb-0">
            Envigado, Antioquia, Colombia |
            <a href="mailto:contacto@lentevivo.com">contacto@lentevivo.com</a>
        </address>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
